[Unit]
Description=DNS proxy with DoH/DoT/DoQ upstreams (dnsproxy.rs)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=on-failure
RestartSec=5s
Environment="RUST_LOG=info"
ExecStart=/usr/bin/dnsproxy-rs --upstream-file /etc/ksutils/dnsproxy/upstreams.txt --port 53
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
