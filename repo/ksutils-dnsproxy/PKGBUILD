# Maintainer: KunoiSayami <i@leanhe.dev>

_basename=dnsproxy
_binname=doh-upstream
pkgname=ksutils-$_basename
pkgver=0.26.0
pkgrel=1
pkgdesc="A DNS proxy/upstream client (DoH, DoH3, DoT, DoQ), ported from AdGuard dnsproxy's Go implementation"
arch=('x86_64' 'aarch64')
url=https://github.com/KunoiSayami/dnsproxy.rs
source=(
    "$pkgname::git+https://github.com/KunoiSayami/dnsproxy.rs.git#tag=v$pkgver"
    "$pkgname.service"
    "upstreams.txt"
)
license=('AGPL-3.0-only')
sha512sums=(
    'SKIP'
    'e6765fdc3f1b12cb28da901de42561ac3f36bb180a983ca053b8502fb4465cb527c9059c624997ced3fa0d50f7c43a5f3e909e070c8288f7785b84263530675e'
    '4ad71fa6d8ba22c9f142c44b73e0e2bfb9b933a2a03ef254095b8b2cdd9050f6054a7cf2c82cd4a42334baefe40e48e36b6a9f66510ec9f537e80e9d88f2fedf'
)
makedepends=('rust' 'git')
depends=('gcc-libs')
options=(!lto !debug)
backup=("etc/ksutils/$_basename/upstreams.txt")

prepare() {
    cd "$pkgname"
    cargo fetch --locked
}

build() {
    cd "$pkgname"

    # Pin the target dir so a global target-dir in ~/.cargo/config.toml
    # cannot move the build output out from under package().
    export CARGO_TARGET_DIR="$srcdir/target"
    # Same feature set as upstream's release binaries.
    cargo build --release --frozen --features all-server,stats
}

check() {
    cd "$pkgname"
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo test --frozen
}

package() {
    install -dm755 "$pkgdir"/etc/ksutils/$_basename
    install -dm755 "$pkgdir"/usr/bin
    install -dm755 "$pkgdir"/usr/lib/systemd/system

    install -m755 target/release/"$_binname" "$pkgdir"/usr/bin/dnsproxy-rs
    install -m644 upstreams.txt "$pkgdir"/etc/ksutils/$_basename/upstreams.txt
    install -m644 "$pkgname.service" "$pkgdir"/usr/lib/systemd/system/

    install -Dm644 "$pkgname"/LICENSE "$pkgdir"/usr/share/licenses/"$pkgname"/LICENSE
    install -Dm644 "$pkgname"/README.md "$pkgdir"/usr/share/doc/"$pkgname"/README.md
}
